rules_version = '2';

// This application deliberately does NOT use the Firestore client SDK from
// the browser. The public website, the admin panel, and the inquiry form
// all read/write Firestore exclusively through Next.js server routes using
// the Firebase ADMIN SDK, which bypasses these rules entirely.
//
// These rules exist purely as defense-in-depth: if the Firestore client SDK
// were ever accidentally added to a client component, or someone connects
// directly with the project's public Firebase config, this denies all
// access by default. There is no legitimate reason for a browser to talk to
// Firestore directly in this architecture.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
